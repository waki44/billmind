# Copy to .env and fill in as the weeks progress. Never commit a filled .env.
DATABASE_URL=postgresql+psycopg://billmind:billmind@localhost:5432/billmind
AUTO_POST_THRESHOLD=0.85
UPLOAD_DIR=uploads

# Week 1 (Day 2-3) — Gmail OAuth
# GMAIL_CREDENTIALS_FILE=credentials.json
# GMAIL_TOKEN_FILE=token.json

# Week 2 (Day 8-9) — vision-LLM fallback (optional; only if a stage-3 provider is chosen)
# VISION_LLM_API_KEY=

# Week 3 (Day 18-19) — QuickBooks Online sandbox OAuth
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:8000/qbo/callback
